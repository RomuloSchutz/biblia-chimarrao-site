---
import '../styles/global.css';
const { title, description } = Astro.props;
const siteUrl = 'https://biblia-chimarrao-site.pages.dev';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bíblia + Chimarrão" />
    <meta property="og:locale" content="pt_BR" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href="/">Bíblia + Chimarrão</a>
        <nav class="nav-links" aria-label="Navegação principal">
          <a href="/projeto/">O Projeto</a>
          <a href="/chimarrao-com-deus/">Chimarrão com Deus</a>
          <a href="/aplicativo/">Aplicativo</a>
          <a href="/livros/">Livros</a>
          <a href="/autor/">Autor</a>
          <a href="/contato/">Contato</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer"><div class="shell"><strong>Bíblia + Chimarrão</strong><br />Palavra, pausa, reflexão e encontro. Projeto de Romulo Schutz.</div></footer>
  </body>
</html>
