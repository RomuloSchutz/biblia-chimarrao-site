---
import '../styles/global.css';
import '../styles/additions.css';
import '../styles/refinements.css';
import '../styles/premium-cards.css';
import '../styles/account-theme.css';
import '../styles/visual-fixes.css';
const { title, description } = Astro.props;
const siteUrl = 'https://bibliachimarrao.com.br';
const appUrl = 'https://biblia-chimarrao-pwa.rommar2179.workers.dev/';
const appIcon192 = 'https://biblia-chimarrao-pwa.rommar2179.workers.dev/icon-192.png';
const appIcon512 = 'https://biblia-chimarrao-pwa.rommar2179.workers.dev/icon-512.png';
const socialImage = `${siteUrl}/assets/biblia-chimarrao-hero-horizontal.jpg`;
const facebookUrl = 'https://www.facebook.com/romuloschutz';
const instagramUrl = 'https://www.instagram.com/romuloschutz/';
const youtubeUrl = 'https://www.youtube.com/@romuloschutz';
const whatsappUrl = 'https://wa.me/5549999004892';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const noIndexPrefixes = ['/minha-conta/', '/entrar/', '/ler-livro/'];
const shouldNoIndex = noIndexPrefixes.some((prefix) => Astro.url.pathname.startsWith(prefix));
const robotsContent = shouldNoIndex ? 'noindex,nofollow,noarchive' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {'@type':'WebSite','@id':`${siteUrl}/#website`,url:siteUrl,name:'Bíblia + Chimarrão',description:'Palavra, pausa, reflexão e encontro com Deus.',inLanguage:'pt-BR',image:socialImage,author:{'@id':`${siteUrl}/autor/#person`}},
    {'@type':'Person','@id':`${siteUrl}/autor/#person`,name:'Romulo Schutz',url:`${siteUrl}/autor/`,email:'mailto:biblia.chimarrao@gmail.com',sameAs:[facebookUrl,instagramUrl,youtubeUrl],jobTitle:'Escritor e pesquisador'},
    {'@type':'WebApplication',name:'Bíblia + Chimarrão',url:appUrl,applicationCategory:'LifestyleApplication',operatingSystem:'Web',inLanguage:'pt-BR',image:socialImage,description:'Aplicativo com devocional, encontro diário, biblioteca, favoritos, anotações, caminhada, lembretes e livros.'}
  ]
};
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="author" content="Romulo Schutz"/><meta name="robots" content={robotsContent}/><meta name="googlebot" content={robotsContent}/><meta name="theme-color" content="#123b31"/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="pt-BR" href={canonical}/><link rel="alternate" hreflang="x-default" href={canonical}/><link rel="manifest" href="/site.webmanifest"/><link rel="icon" type="image/png" sizes="192x192" href={appIcon192}/><link rel="shortcut icon" type="image/png" href={appIcon192}/><link rel="apple-touch-icon" sizes="192x192" href={appIcon192}/><link rel="apple-touch-icon" sizes="512x512" href={appIcon512}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Bíblia + Chimarrão"/><meta property="og:locale" content="pt_BR"/><meta property="og:image" content={socialImage}/><meta property="og:image:secure_url" content={socialImage}/><meta property="og:image:type" content="image/jpeg"/><meta property="og:image:alt" content="Bíblia + Chimarrão — projeto de Romulo Schutz"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><script type="application/ld+json" set:html={JSON.stringify(structuredData)}/><script is:inline>
(function(){
  const mq=window.matchMedia('(prefers-color-scheme: dark)');
  const apply=()=>{
    const pref=localStorage.getItem('bc-theme')||'system';
    const dark=pref==='dark'||(pref==='system'&&mq.matches);
    document.documentElement.dataset.theme=dark?'dark':'light';
    document.documentElement.dataset.themePreference=pref;
  };
  apply();
  mq.addEventListener?.('change',()=>{if((localStorage.getItem('bc-theme')||'system')==='system')apply();});
})();
</script><title>{title}</title></head><body>
<header class="site-header"><div class="shell nav"><a class="brand" href="/" aria-label="Bíblia + Chimarrão — início">Bíblia + Chimarrão</a><nav class="nav-links" aria-label="Navegação principal"><a href="/projeto/">O Projeto</a><a href="/chimarrao-com-deus/">Chimarrão com Deus</a><a href="/aplicativo/">Aplicativo</a><a href="/livros/">Livros</a><a href="/loja/">Loja</a><a href="/autor/">Autor</a><a href="/contato/">Contato</a><a class="account-link" href="/minha-conta/">Minha Conta</a></nav><details class="mobile-nav"><summary aria-label="Abrir menu"><span>Menu</span></summary><nav aria-label="Navegação móvel" class="mobile-menu-panel"><div class="mobile-menu-brand"><span class="mobile-menu-monogram">B+C</span><div><strong>Bíblia + Chimarrão</strong><small>Palavra · pausa · reflexão · encontro</small></div></div><div class="mobile-menu-links"><a href="/projeto/"><span>✦</span><div><strong>O Projeto</strong><small>Conheça a proposta</small></div></a><a href="/chimarrao-com-deus/"><span>🧉</span><div><strong>Chimarrão com Deus</strong><small>365 encontros com Deus</small></div></a><a href="/aplicativo/"><span>◫</span><div><strong>Aplicativo</strong><small>A experiência interativa</small></div></a><a href="/livros/"><span>▤</span><div><strong>Livros</strong><small>Biblioteca de Romulo Schutz</small></div></a><a href="/loja/"><span>◇</span><div><strong>Loja</strong><small>Livros e acesso digital</small></div></a><a href="/autor/"><span>✒</span><div><strong>Autor</strong><small>Trajetória e escrita</small></div></a><a href="/contato/"><span>✉</span><div><strong>Contato</strong><small>Fale com o projeto</small></div></a></div><div class="mobile-menu-actions"><a class="mobile-account-link" href="/minha-conta/">Minha Conta <b>→</b></a><a class="mobile-app-link" href={appUrl} target="_blank" rel="noopener noreferrer">Abrir aplicativo <b>↗</b></a></div></nav></details></div></header>
<main><slot /></main>
<footer class="footer"><div class="shell footer-grid"><div><strong>Bíblia + Chimarrão</strong><br/>Palavra, pausa, reflexão e encontro. Projeto de Romulo Schutz.<div class="footer-institutional"><small><strong>Titular:</strong> Romulo Schutz<br/><strong>CNPJ:</strong> 64.323.171/0001-34<br/><strong>Endereço:</strong> Rua Vinicius de Moraes, 335 · Centro · Otacílio Costa/SC</small></div></div><div class="footer-links"><a href="/minha-conta/">Minha Conta</a><a href={appUrl} target="_blank" rel="noopener noreferrer">Acessar aplicativo</a><a href="/livros/">Livros</a><a href="/loja/">Loja</a><a href="/autor/">Sobre o autor</a><a href={facebookUrl} target="_blank" rel="noopener noreferrer">Facebook · Romulo Schutz</a><a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram · @romuloschutz</a><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">YouTube · @romuloschutz</a><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a><a href="mailto:biblia.chimarrao@gmail.com">biblia.chimarrao@gmail.com</a></div></div></footer>
</body></html>
