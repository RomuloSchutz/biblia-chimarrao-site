---
import Base from '../../layouts/Base.astro';
const appUrl='https://biblia-chimarrao-pwa.rommar2179.workers.dev/';
---
<Base title="Minha Conta | Bíblia + Chimarrão" description="Consulte o acesso ao devocional, livros adquiridos e configurações da sua conta Bíblia + Chimarrão.">
<section class="hero account-hero"><div class="shell"><div class="eyebrow">Área do leitor</div><h1>Minha Conta</h1><p class="lead">Seu acesso acompanha você. Compras feitas no site ou no aplicativo ficam vinculadas à mesma conta.</p></div></section>
<section><div class="shell"><div id="account-loading" class="account-panel"><p>Verificando sua conta...</p></div>
<div id="account-guest" class="account-panel" hidden><h2>Entre para continuar.</h2><p>Use o mesmo e-mail e senha do aplicativo Bíblia + Chimarrão.</p><div class="actions"><a class="btn primary" href="/entrar/">Entrar ou criar conta</a></div></div>
<div id="account-content" hidden>
  <div class="account-summary"><div><div class="eyebrow">Conta conectada</div><h2 id="reader-name">Leitor</h2><p id="reader-email"></p><div id="admin-entry" class="actions" hidden><a class="btn primary" href="/admin/">Painel administrativo</a></div></div><button id="account-logout" class="btn secondary" type="button">Sair</button></div>
  <div class="grid-3 account-access-grid">
    <article class="card"><div class="eyebrow">Devocional 2027</div><h3 id="annual-title">Bíblia + Chimarrão — Edição 2027</h3><p id="annual-status">Verificando acesso...</p><div id="annual-actions" class="actions"></div></article>
    <article class="card"><div class="eyebrow">Meus livros</div><h3>Sua biblioteca digital</h3><p id="books-status">Verificando seus livros...</p><div class="actions"><a class="btn secondary" href="#book-library">Ver minha biblioteca</a></div></article>
    <article class="card"><div class="eyebrow">Aplicativo</div><h3>Continue onde preferir.</h3><p>A mesma conta funciona no aplicativo. Seus direitos de acesso são consultados no mesmo cadastro.</p><div class="actions"><a class="btn secondary" href={appUrl} target="_blank" rel="noopener noreferrer">Abrir aplicativo ↗</a></div></article>
  </div>
  <section class="account-library-section"><div class="eyebrow">Biblioteca vinculada à conta</div><h2>Livros adquiridos</h2><div id="book-library" class="book-grid two"></div></section>
  <section class="account-settings-section" id="configuracoes"><div class="eyebrow">Preferências da conta</div><h2>Configurações</h2><div class="settings-grid">
    <article class="card settings-card"><div class="setting-icon" aria-hidden="true">◐</div><div><h3>Aparência do site</h3><p>Escolha como o Bíblia + Chimarrão deve aparecer neste aparelho.</p><label class="setting-label" for="theme-select">Tema</label><select id="theme-select" class="setting-select"><option value="system">Usar configuração do sistema</option><option value="light">Claro</option><option value="dark">Escuro</option></select><p class="setting-help">A preferência fica salva neste navegador e pode ser alterada quando quiser.</p></div></article>
    <article class="card settings-card"><div class="setting-icon" aria-hidden="true">✦</div><div><h3>Alterar senha</h3><p>Por segurança, confirme sua senha atual antes de definir uma nova senha para a mesma conta usada no site e no aplicativo.</p><form id="password-form" class="password-form"><label>Senha atual<div class="password-input-wrap"><input id="current-password" type="password" autocomplete="current-password" required placeholder="Digite sua senha atual"/><button class="password-toggle" type="button" data-target="current-password" aria-label="Mostrar senha atual" aria-pressed="false">👁</button></div></label><label>Nova senha<div class="password-input-wrap"><input id="new-password" type="password" autocomplete="new-password" minlength="8" required placeholder="Mínimo de 8 caracteres"/><button class="password-toggle" type="button" data-target="new-password" aria-label="Mostrar nova senha" aria-pressed="false">👁</button></div></label><label>Confirmar nova senha<div class="password-input-wrap"><input id="confirm-password" type="password" autocomplete="new-password" minlength="8" required placeholder="Repita a nova senha"/><button class="password-toggle" type="button" data-target="confirm-password" aria-label="Mostrar confirmação da senha" aria-pressed="false">👁</button></div></label><button id="password-submit" class="btn primary" type="submit">Atualizar senha</button><p id="password-message" class="form-message" aria-live="polite"></p></form></div></article>
  </div></section>
</div></div></section>
<style>
  .password-input-wrap{position:relative;display:block}
  .password-input-wrap input{width:100%;padding-right:58px}
  .password-toggle{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:44px;height:44px;margin:0;padding:0;border:0;border-radius:999px;background:transparent;color:inherit;font-size:21px;line-height:1;cursor:pointer;display:grid;place-items:center}
  .password-toggle:hover,.password-toggle:focus-visible{background:rgba(216,176,83,.14);outline:2px solid rgba(216,176,83,.55);outline-offset:1px}
</style>
<script>
 import { supabase } from '../../lib/supabase-browser.js';
 const appUrl='https://biblia-chimarrao-pwa.rommar2179.workers.dev/';
 const loading=document.querySelector('#account-loading'), guest=document.querySelector('#account-guest'), content=document.querySelector('#account-content');
 const logoutButton=document.querySelector('#account-logout');
 logoutButton?.addEventListener('click',async()=>{
   logoutButton.disabled=true;
   logoutButton.textContent='Saindo...';
   try{
     const {error}=await supabase.auth.signOut({scope:'local'});
     if(error)throw error;
     window.location.replace('/entrar/');
   }catch(error){
     logoutButton.disabled=false;
     logoutButton.textContent='Sair';
     console.error('Falha ao sair da conta:',error);
     alert('Não foi possível sair da conta agora. Tente novamente.');
   }
 });
 const {data:{session}}=await supabase.auth.getSession();
 if(!session?.user){loading.hidden=true;guest.hidden=false;} else {
   const user=session.user;loading.hidden=true;content.hidden=false;document.querySelector('#reader-name').textContent=user.user_metadata?.full_name||user.email?.split('@')[0]||'Leitor';document.querySelector('#reader-email').textContent=user.email||'';
   const [adminResult,annual,library]=await Promise.all([supabase.rpc('is_app_admin'),supabase.rpc('get_my_annual_access',{target_year:2027}),supabase.rpc('my_book_library')]);
   const isAdmin=adminResult.data===true;
   if(isAdmin){document.querySelector('#admin-entry').hidden=false;}
   const row=annual.data?.[0];const annualStatus=document.querySelector('#annual-status');const annualActions=document.querySelector('#annual-actions');
   if(row?.allowed){annualStatus.textContent='Acesso liberado. Você pode ler a Edição 2027 pelo site ou pelo aplicativo.';annualActions.innerHTML='<a class="btn primary" href="/devocional/">Ler no site</a>';} else {annualStatus.textContent='A Edição 2027 ainda não está vinculada a esta conta.';annualActions.innerHTML='<a class="btn primary" href="/loja/">Conhecer acesso 2027</a>';}
   const available=(library.data||[]).filter(x=>x.has_access);document.querySelector('#books-status').textContent=available.length?`${available.length} obra(s) disponível(is) nesta conta.`:'Você ainda não possui livros digitais vinculados a esta conta.';
   const target=document.querySelector('#book-library');
   target.innerHTML=available.length?available.map(b=>`<article class="book-card card"><span class="book-number">${b.source==='admin'?'ACESSO DO AUTOR':'ADQUIRIDO'}</span><h3>${escapeHtml(b.title)}</h3>${b.subtitle?`<p class="kicker">${escapeHtml(b.subtitle)}</p>`:''}<p>${b.is_ready?'Arquivo digital disponível para leitura segura no site e no aplicativo.':'Obra vinculada à sua conta; arquivo em preparação.'}</p><div class="actions">${b.is_ready?`<a class="btn primary" href="/ler-livro/?edition=${encodeURIComponent(b.edition_id)}">Ler no site</a>`:''}<a class="btn secondary" href="${appUrl}" target="_blank" rel="noopener noreferrer">Abrir aplicativo ↗</a></div></article>`).join(''):'<article class="card"><h3>Sua biblioteca está pronta para crescer.</h3><p>Os livros comprados no site ou no aplicativo aparecerão aqui automaticamente.</p></article>';
 }
 function escapeHtml(v=''){return String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}
 const themeSelect=document.querySelector('#theme-select');
 const media=window.matchMedia('(prefers-color-scheme: dark)');
 const applyTheme=(pref)=>{const dark=pref==='dark'||(pref==='system'&&media.matches);document.documentElement.dataset.theme=dark?'dark':'light';document.documentElement.dataset.themePreference=pref;localStorage.setItem('bc-theme',pref);};
 if(themeSelect){themeSelect.value=localStorage.getItem('bc-theme')||'system';themeSelect.addEventListener('change',()=>applyTheme(themeSelect.value));}
 document.querySelectorAll('.password-toggle').forEach(button=>button.addEventListener('click',()=>{
   const input=document.getElementById(button.dataset.target||'');if(!input)return;const show=input.type==='password';input.type=show?'text':'password';button.setAttribute('aria-label',show?'Ocultar senha':'Mostrar senha');button.setAttribute('aria-pressed',String(show));button.textContent=show?'🙈':'👁';
 }));
 document.querySelector('#password-form')?.addEventListener('submit',async(e)=>{
   e.preventDefault();const form=e.currentTarget;const current=document.querySelector('#current-password').value;const pass=document.querySelector('#new-password').value;const confirm=document.querySelector('#confirm-password').value;const msg=document.querySelector('#password-message');const submit=document.querySelector('#password-submit');
   if(!current){msg.textContent='Digite sua senha atual.';return;}if(pass.length<8){msg.textContent='Use pelo menos 8 caracteres na nova senha.';return;}if(pass!==confirm){msg.textContent='As duas novas senhas precisam ser iguais.';return;}if(current===pass){msg.textContent='A nova senha precisa ser diferente da senha atual.';return;}
   submit.disabled=true;submit.textContent='Atualizando...';msg.textContent='Confirmando sua senha atual e atualizando...';
   try{const {error}=await supabase.auth.updateUser({current_password:current,password:pass});if(error){const text=String(error.message||'').toLowerCase();msg.textContent=text.includes('current password')||text.includes('invalid credentials')?'A senha atual está incorreta.':'Não foi possível alterar a senha: '+error.message;submit.disabled=false;submit.textContent='Atualizar senha';return;}form.reset();msg.textContent='Senha atualizada com sucesso.';submit.textContent='Senha atualizada';window.setTimeout(()=>{window.location.href='/minha-conta/';},900);}catch(error){msg.textContent='Não foi possível alterar a senha agora. Tente novamente.';submit.disabled=false;submit.textContent='Atualizar senha';}
 });
</script>
</Base>
