---
import Base from '../../layouts/Base.astro';
const appUrl='https://biblia-chimarrao-pwa.rommar2179.workers.dev/';
const produtos=[
 {code:'app_biblia_chimarrao',tipo:'ACESSO ANUAL',titulo:'Bíblia + Chimarrão — Edição 2027',sub:'365 encontros, caminhada, favoritos, anotações e recursos da edição anual.',capa:'/assets/capa-chimarrao-com-deus.jpg',href:'/chimarrao-com-deus/'},
 {code:'devocional_chimarrao_com_deus_2027',tipo:'E-BOOK DEVOCIONAL',titulo:'Chimarrão com Deus — 365 Encontros com Deus',sub:'A edição editorial digital do devocional, independente do acesso anual interativo.',capa:'/assets/capa-chimarrao-com-deus.jpg',href:'/livros/chimarrao-com-deus/'},
 {code:'ebook_entre_os_tempos',tipo:'E-BOOK',titulo:'Entre os Tempos',sub:'A Urgência de Compreender o Calendário de Deus',capa:'/assets/capa-entre-os-tempos.jpg',href:'/livros/entre-os-tempos/'},
 {code:'ebook_entre_ja_ainda_nao',tipo:'E-BOOK',titulo:'Entre o Já e o Ainda Não',sub:'A Esperança Inabalável em um Mundo Acelerado',capa:'/assets/capa-entre-o-ja-e-o-ainda-nao.jpg',href:'/livros/entre-o-ja-e-o-ainda-nao/'},
 {code:'ebook_cristo_marco',tipo:'E-BOOK',titulo:'Cristo: O Marco entre o Antes e o Depois',sub:'Como a fé, a história e o calendário se encontram na linha do tempo',capa:'/assets/capa-cristo-o-marco.png',href:'/livros/cristo-o-marco/'}
];
const emBreve=[
 {titulo:'Entre os Sistemas — Volume 1',sub:'Religioso, Filosófico, Político e Econômico — Cristo, o Libertador',capa:'/assets/capa-entre-os-sistemas-volume-1.png',href:'/livros/entre-os-sistemas-volume-1/'},
 {titulo:'Entre os Sistemas — Volume 2',sub:'Fé e Doutrina — Suficiência de Cristo',capa:'/assets/capa-entre-os-sistemas-volume-2.png',href:'/livros/entre-os-sistemas-volume-2/'},
 {titulo:'Entre a Honra e a Gratidão',sub:'Lealdade, Fidelidade, Obediência e Amor',capa:'/assets/capa-entre-a-honra-e-a-gratidao.png',href:'/livros/entre-a-honra-e-a-gratidao/'}
];
---
<Base title="Loja | Bíblia + Chimarrão" description="Compre o acesso anual Bíblia + Chimarrão e livros digitais de Romulo Schutz com a mesma conta usada no aplicativo.">
<section class="hero"><div class="shell split"><div><div class="eyebrow">Loja digital</div><h1>Escolha o que faz sentido para sua caminhada.</h1><p class="lead">Livro e acesso anual são produtos independentes. Você pode adquirir somente um e-book, somente a experiência anual do Bíblia + Chimarrão ou combinar os dois.</p></div><div class="card"><div class="eyebrow">Uma conta</div><h3>Compre aqui. Acesse também no aplicativo.</h3><p>As aquisições ficam vinculadas à sua conta. Use o mesmo e-mail e senha no site e no aplicativo.</p><div class="actions"><a class="btn secondary" href="/minha-conta/">Minha Conta</a></div></div></div></section>
<section><div class="shell"><div class="eyebrow">Disponíveis</div><h2>Produtos ativos.</h2><p class="lead">Os valores abaixo são carregados diretamente do catálogo comercial oficial.</p><div class="store-cover-grid">{produtos.map(p=><article class="store-cover-card" data-store-card={p.code}><a class="store-cover-link" href={p.href} aria-label={`Conhecer ${p.titulo}`}><img src={p.capa} alt={`Capa de ${p.titulo}`} loading="lazy"/></a><div class="store-meta"><span class="book-number">{p.tipo}</span><strong class="store-price" data-price={p.code}>Carregando valor...</strong></div><div class="actions"><a class="btn secondary" href={p.href}>Conhecer</a><button class="btn primary buy-button" type="button" data-buy={p.code} disabled>Comprar</button></div></article>)}</div>
<div class="purchase-consent"><label><input id="purchase-accepted" type="checkbox"/> Li e aceito a <a href="/politicas/#compras" target="_blank">Política de Compra, Cancelamento e Reembolso Digital</a> e a <a href="/politicas/#licenca" target="_blank">Licença de Uso de Conteúdos Digitais</a>.</label><p id="store-message" class="form-message" role="status"></p></div></div></section>
<section class="development-section"><div class="shell"><div class="eyebrow">Pré-lançamentos</div><h2>Em preparação para 2027.</h2><div class="store-cover-grid">{emBreve.map(p=><article class="store-cover-card prelaunch-cover"><a class="store-cover-link" href={p.href}><img src={p.capa} alt={`Capa de ${p.titulo}`} loading="lazy"/></a><span class="status-badge">EM BREVE · LANÇAMENTO 2027</span><div class="actions"><a class="btn secondary" href={p.href}>Conhecer a obra</a></div></article>)}</div></div></section>
<section><div class="shell split"><div><div class="eyebrow">Duas portas de entrada</div><h2>Site e aplicativo trabalham juntos.</h2></div><div><p class="lead">Quem quiser apenas um livro compra apenas o livro. Quem adquirir a Edição 2027 pode viver o devocional no aplicativo e também lê-lo pelo site usando a mesma conta.</p><div class="actions"><a class="btn primary" href={appUrl} target="_blank" rel="noopener noreferrer">Abrir aplicativo</a><a class="btn secondary" href="/devocional/">Ler no site</a></div></div></div></section>
<script>
 import { supabase } from '../../lib/supabase-browser.js';
 const message=document.querySelector('#store-message'),accepted=document.querySelector('#purchase-accepted');
 const {data:catalog,error}=await supabase.rpc('get_commercial_catalog');
 const products=Object.fromEntries((catalog||[]).map(p=>[p.code,p]));
 document.querySelectorAll('[data-price]').forEach(el=>{const p=products[el.dataset.price];el.textContent=p&&p.is_active?new Intl.NumberFormat('pt-BR',{style:'currency',currency:p.currency||'BRL'}).format(p.amount_cents/100):'Indisponível';});
 document.querySelectorAll('[data-buy]').forEach(button=>{const p=products[button.dataset.buy];button.disabled=!p?.is_active;button.addEventListener('click',()=>purchase(button.dataset.buy));});
 async function purchase(code){message.textContent='';const {data:{session}}=await supabase.auth.getSession();if(!session){message.textContent='Entre na sua conta antes de comprar.';setTimeout(()=>window.location.href='/entrar/',700);return;}if(!accepted.checked){message.textContent='Leia e aceite as condições de compra e licença digital para continuar.';return;}const button=document.querySelector(`[data-buy="${code}"]`);button.disabled=true;message.textContent='Preparando checkout seguro do Mercado Pago...';const {data,error}=await supabase.functions.invoke('mercado-pago-create-order',{body:{product_code:code,accepted:true,access_token:session.access_token}});if(error||!data?.checkout_url){message.textContent='Não foi possível iniciar o checkout. Tente novamente.';button.disabled=false;return;}window.location.href=data.checkout_url;}
</script>
</Base>
