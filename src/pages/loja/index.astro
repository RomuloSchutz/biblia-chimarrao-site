---
import Base from '../../layouts/Base.astro';
const appUrl='https://biblia-chimarrao-pwa.rommar2179.workers.dev/';
const produtos=[
 {code:'app_biblia_chimarrao',tipo:'ACESSO ANUAL',titulo:'Bíblia + Chimarrão — Edição 2027',capa:'/assets/capa-chimarrao-com-deus.jpg',href:'/chimarrao-com-deus/'},
 {code:'devocional_chimarrao_com_deus_2027',tipo:'E-BOOK DEVOCIONAL',titulo:'Chimarrão com Deus — 365 Encontros com Deus',capa:'/assets/capa-chimarrao-com-deus.png',href:'/livros/chimarrao-com-deus/',isbn:'978-65-978406-0-1'},
 {code:'ebook_entre_os_tempos',tipo:'E-BOOK',titulo:'Entre os Tempos',capa:'/assets/capa-entre-os-tempos.jpg',href:'/livros/entre-os-tempos/'},
 {code:'ebook_entre_ja_ainda_nao',tipo:'E-BOOK',titulo:'Entre o Já e o Ainda Não',capa:'/assets/capa-entre-o-ja-e-o-ainda-nao.jpg',href:'/livros/entre-o-ja-e-o-ainda-nao/'},
 {code:'ebook_cristo_marco',tipo:'E-BOOK',titulo:'Cristo: O Marco entre o Antes e o Depois',capa:'/assets/capa-cristo-o-marco.png',href:'/livros/cristo-o-marco/'}
];
const emBreve=[
 {titulo:'Entre os Sistemas — Volume 1',capa:'/assets/capa-entre-os-sistemas-volume-1.png',href:'/livros/entre-os-sistemas-volume-1/'},
 {titulo:'Entre os Sistemas — Volume 2',capa:'/assets/capa-entre-os-sistemas-volume-2.png',href:'/livros/entre-os-sistemas-volume-2/'},
 {titulo:'Entre a Honra e a Gratidão',capa:'/assets/capa-entre-a-honra-e-a-gratidao.png',href:'/livros/entre-a-honra-e-a-gratidao/'}
];
---
<Base title="Loja | Bíblia + Chimarrão" description="Compre o acesso anual Bíblia + Chimarrão e livros digitais de Romulo Schutz com a mesma conta usada no aplicativo.">
<section class="hero compact-hero"><div class="shell split"><div><div class="eyebrow">Loja digital</div><h1>Escolha o que faz sentido para sua caminhada.</h1><p class="lead">Livro e acesso anual são produtos independentes. Você pode adquirir somente um e-book, somente a experiência anual ou combinar os dois.</p><p>A proposta da loja é simples: primeiro conhecer, depois escolher. Cada obra possui uma página própria para que você entenda o tema, a intenção e o caminho de leitura antes da compra.</p></div><div class="card"><div class="eyebrow">Uma conta</div><h3>Compre aqui. Acesse também no aplicativo.</h3><p>As aquisições ficam vinculadas à sua conta. Use o mesmo e-mail e senha no site e no aplicativo para manter sua biblioteca e seus acessos em um único lugar.</p></div></div></section>
<section><div class="shell"><div id="payment-return-banner" class="payment-return-banner" hidden></div><div class="eyebrow">Disponíveis</div><h2>Leituras para momentos diferentes da caminhada.</h2><p class="lead store-intro">Há livros para compreender o tempo, discernir o mundo, sustentar a esperança e cultivar uma vida de fé mais consciente. Clique em “Conhecer” para entrar na página editorial da obra antes de decidir pela compra.</p><div class="store-cover-grid">{produtos.map(p=><article class="store-cover-card" data-store-card={p.code}><a class="store-cover-link" href={p.href}><img src={p.capa} alt={`Capa de ${p.titulo}`} loading="lazy"/></a><div class="store-meta"><span class="book-number">{p.tipo}</span><h3 class="store-title">{p.titulo}</h3>{p.isbn&&<small class="store-isbn">ISBN {p.isbn}</small>}<strong class="store-price" data-price={p.code}>Carregando valor...</strong></div><div class="actions" data-actions={p.code}><a class="btn secondary" href={p.href}>Conhecer</a><button class="btn primary buy-button" type="button" data-buy={p.code} disabled>Comprar</button></div></article>)}</div><p id="store-message" class="form-message" role="status"></p></div></section>
<section class="development-section"><div class="shell"><div class="eyebrow">Pré-lançamentos</div><h2>Obras que continuam sendo construídas.</h2><p class="lead">Acompanhe os próximos títulos e conheça desde já a trajetória editorial que está sendo preparada para novas leituras.</p><div class="store-cover-grid">{emBreve.map(p=><article class="store-cover-card prelaunch-cover" data-prelaunch-title={p.titulo}><a class="store-cover-link" href={p.href}><img src={p.capa} alt={`Capa de ${p.titulo}`} loading="lazy"/></a><span class="status-badge">EM BREVE · LANÇAMENTO 2027</span><div class="prelaunch-admin-actions"></div></article>)}</div></div></section>
<section><div class="shell split"><div><div class="eyebrow">Duas portas de entrada</div><h2>Site e aplicativo trabalham juntos.</h2></div><div><p class="lead">Quem quiser apenas um livro compra apenas o livro. Quem adquirir a Edição 2027 pode viver o devocional no aplicativo e também lê-lo pelo site usando a mesma conta.</p><p>Você escolhe a forma de entrar; o conteúdo permanece conectado à sua caminhada.</p><div class="actions"><a class="btn primary" href={appUrl} target="_blank" rel="noopener noreferrer">Abrir aplicativo</a><a class="btn secondary" href="/devocional/">Ler no site</a></div></div></div></section>

<div id="purchase-modal" class="purchase-modal" hidden aria-hidden="true"><div class="purchase-modal-backdrop" data-close-purchase></div><section class="purchase-modal-panel" role="dialog" aria-modal="true" aria-labelledby="purchase-modal-title"><button class="purchase-modal-close" type="button" aria-label="Fechar" data-close-purchase>×</button><div class="eyebrow">Antes de continuar</div><h2 id="purchase-modal-title">Confirme sua compra</h2><p id="purchase-product-name" class="lead"></p><p>Leia as condições aplicáveis ao conteúdo digital antes de seguir para o pagamento.</p><div class="purchase-policy-links"><a class="btn secondary" href="/politicas/#compras" target="_blank" rel="noopener noreferrer">Ler política de compra</a><a class="btn secondary" href="/politicas/#licenca" target="_blank" rel="noopener noreferrer">Ler licença digital</a></div><label class="purchase-accept-line"><input id="modal-purchase-accepted" type="checkbox"/> <span>Li e aceito a Política de Compra, Cancelamento e Reembolso Digital e a Licença de Uso de Conteúdos Digitais.</span></label><p id="purchase-modal-message" class="form-message" role="status"></p><div class="actions purchase-modal-actions"><button id="purchase-cancel" class="btn secondary" type="button">Voltar</button><button id="purchase-continue" class="btn primary" type="button" disabled>Prosseguir para pagamento</button></div></section></div>

<style>
 .payment-return-banner{margin:0 0 24px;padding:18px 20px;border:1px solid rgba(230,196,135,.7);border-radius:18px;background:rgba(18,59,49,.72);color:#f8e5bb;font-weight:700}.purchase-modal[hidden]{display:none!important}.purchase-modal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:18px}.purchase-modal-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(3px)}.purchase-modal-panel{position:relative;z-index:1;width:min(620px,100%);max-height:88vh;overflow:auto;padding:28px;border:1px solid rgba(201,154,67,.72);border-radius:24px;background:linear-gradient(160deg,#123f31,#092d24);box-shadow:0 24px 70px rgba(0,0,0,.5)}.purchase-modal-close{position:absolute;right:14px;top:10px;border:0;background:transparent;color:#f8e8bd;font-size:34px;line-height:1;cursor:pointer}.purchase-policy-links{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.purchase-accept-line{display:flex;gap:12px;align-items:flex-start;padding:16px;border:1px solid rgba(201,154,67,.38);border-radius:16px;background:rgba(255,255,255,.035)}.purchase-accept-line input{width:21px;height:21px;margin-top:2px;flex:0 0 auto}.purchase-modal-actions{margin-top:18px}.purchase-modal-actions .btn{flex:1}.purchase-modal-open{overflow:hidden}.store-download-note{display:block;width:100%;margin-top:4px;color:rgba(255,248,236,.72);font-size:.75rem}@media(max-width:640px){.purchase-modal-panel{padding:24px 18px;border-radius:18px}.purchase-policy-links{grid-template-columns:1fr}.purchase-modal-actions{display:grid;grid-template-columns:1fr}.purchase-modal-actions .btn{width:100%}}
</style>

<script>
 import { supabase } from '../../lib/supabase-browser.js';
 const message=document.querySelector('#store-message');const modal=document.querySelector('#purchase-modal');const modalAccepted=document.querySelector('#modal-purchase-accepted');const modalMessage=document.querySelector('#purchase-modal-message');const modalProductName=document.querySelector('#purchase-product-name');const continueButton=document.querySelector('#purchase-continue');const cancelButton=document.querySelector('#purchase-cancel');const returnBanner=document.querySelector('#payment-return-banner');
 const epubAccessUrl='https://srabzgokulsiujusbqxl.supabase.co/functions/v1/book-epub-access';const publishableKey='sb_publishable_TjLHUAq038yLQ2hqqaVZjg__GM4w2Q4';let pendingCode='';
 const query=new URLSearchParams(window.location.search);const paymentReturn=query.get('payment_return');
 if(paymentReturn&&returnBanner){returnBanner.hidden=false;if(paymentReturn==='success'){returnBanner.textContent='Pagamento recebido. Estamos confirmando sua compra e abrindo sua biblioteca…';setTimeout(()=>window.location.replace('/minha-conta/#book-library'),2200)}else if(paymentReturn==='pending'){returnBanner.textContent='Pagamento em processamento. Assim que o Mercado Pago confirmar, o acesso será liberado automaticamente.'}else{returnBanner.textContent='O pagamento não foi concluído. Você pode tentar novamente quando quiser.'}}
 const {data:catalog}=await supabase.rpc('get_commercial_catalog');const products=Object.fromEntries((catalog||[]).map(p=>[p.code,p]));const {data:{session}}=await supabase.auth.getSession();let isAdmin=false;let library=[];
 if(session?.user){const [adminResult,libraryResult]=await Promise.all([supabase.rpc('is_app_admin'),supabase.rpc('my_book_library')]);isAdmin=adminResult.data===true;library=libraryResult.data||[];}
 const normalize=(value='')=>String(value).normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9]+/g,' ').trim().toLowerCase();const byEdition=new Map(library.filter(x=>x.edition_id).map(x=>[x.edition_id,x]));const byTitle=new Map(library.map(x=>[normalize(x.title),x]));const findLibraryItem=(product)=>{if(product?.edition_id&&byEdition.has(product.edition_id))return byEdition.get(product.edition_id);const key=normalize(product?.title||'');return byTitle.get(key)||library.find(x=>{const bookKey=normalize(x.title);return key&&bookKey&&(key.startsWith(bookKey)||bookKey.startsWith(key));})||null;};
 document.querySelectorAll('[data-price]').forEach(el=>{const code=el.dataset.price,p=products[code],item=findLibraryItem(p);const hasAccess=isAdmin||(item?.has_access===true);if(hasAccess){el.textContent=isAdmin?'ACESSO DO AUTOR':'JÁ ADQUIRIDO';el.classList.add('store-access-label');return;}el.textContent=p&&p.is_active?new Intl.NumberFormat('pt-BR',{style:'currency',currency:p.currency||'BRL'}).format(p.amount_cents/100):'Indisponível';});
 document.querySelectorAll('[data-buy]').forEach(button=>{const code=button.dataset.buy,p=products[code],card=document.querySelector(`[data-store-card="${code}"]`),actions=document.querySelector(`[data-actions="${code}"]`),item=findLibraryItem(p);const hasBookAccess=isAdmin||(item?.has_access===true);if(code==='app_biblia_chimarrao'&&isAdmin){button.remove();actions.insertAdjacentHTML('beforeend','<a class="btn primary" href="/devocional/">Abrir devocional</a>');card?.classList.add('has-library-access');return;}if(hasBookAccess&&item?.is_ready){button.remove();actions.insertAdjacentHTML('beforeend',`<a class="btn primary" href="/ler-livro/?edition=${encodeURIComponent(item.edition_id)}">Ler no site</a><button class="btn secondary store-download-button" type="button" data-download-edition="${item.edition_id}" data-download-title="${String(item.title||'livro').replace(/"/g,'&quot;')}">Baixar EPUB</button><small class="store-download-note">Download liberado 7 dias após a confirmação do pagamento.</small>`);card?.classList.add('has-library-access');return;}button.disabled=!p?.is_active;button.addEventListener('click',()=>openPurchase(code));});
 document.querySelectorAll('.store-download-button').forEach(button=>button.addEventListener('click',async()=>{if(!session?.access_token){message.textContent='Entre na sua conta para verificar o download.';return;}button.disabled=true;message.textContent='Verificando a data de liberação do EPUB…';try{const response=await fetch(epubAccessUrl,{method:'POST',headers:{'Content-Type':'application/json','apikey':publishableKey},body:JSON.stringify({edition_id:button.dataset.downloadEdition,access_token:session.access_token,download:true})});const data=await response.json().catch(()=>({}));if(!response.ok){if(data?.download_available_at){const date=new Intl.DateTimeFormat('pt-BR',{dateStyle:'long'}).format(new Date(data.download_available_at));message.textContent=`Este EPUB será liberado para download em ${date}.`;button.textContent='EPUB · '+new Intl.DateTimeFormat('pt-BR').format(new Date(data.download_available_at));return;}throw new Error(data?.error||'Não foi possível liberar o download.');}const a=document.createElement('a');a.href=data.signed_url;a.download=(button.dataset.downloadTitle||'livro')+'.epub';a.rel='noopener';document.body.appendChild(a);a.click();a.remove();button.textContent='Baixar EPUB';message.textContent='Download do EPUB liberado.';}catch(err){message.textContent=err instanceof Error?err.message:'Não foi possível liberar o EPUB.';}finally{button.disabled=false;}}));
 if(isAdmin){document.querySelectorAll('[data-prelaunch-title]').forEach(card=>{const title=card.dataset.prelaunchTitle;const item=byTitle.get(normalize(title));if(item?.is_ready){card.querySelector('.status-badge').textContent='ACESSO DO AUTOR';card.querySelector('.prelaunch-admin-actions')?.insertAdjacentHTML('beforeend',`<a class="btn primary" href="/ler-livro/?edition=${encodeURIComponent(item.edition_id)}">Ler no site</a>`);card.classList.add('has-library-access');}});}
 function openPurchase(code){message.textContent='';pendingCode=code;modalAccepted.checked=false;continueButton.disabled=true;modalMessage.textContent='';const p=products[code];modalProductName.textContent=p?.title||'Conteúdo digital';modal.hidden=false;modal.setAttribute('aria-hidden','false');document.documentElement.classList.add('purchase-modal-open');setTimeout(()=>modalAccepted.focus(),50)}
 function closePurchase(){modal.hidden=true;modal.setAttribute('aria-hidden','true');document.documentElement.classList.remove('purchase-modal-open');pendingCode=''}
 modalAccepted?.addEventListener('change',()=>{continueButton.disabled=!modalAccepted.checked;modalMessage.textContent=''});cancelButton?.addEventListener('click',closePurchase);document.querySelectorAll('[data-close-purchase]').forEach(el=>el.addEventListener('click',closePurchase));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!modal.hidden)closePurchase()});
 continueButton?.addEventListener('click',async()=>{if(!pendingCode||!modalAccepted.checked)return;const {data:{session:currentSession}}=await supabase.auth.getSession();if(!currentSession){modalMessage.textContent='Entre na sua conta antes de comprar.';setTimeout(()=>window.location.href='/entrar/',700);return;}continueButton.disabled=true;modalMessage.textContent='Preparando checkout seguro do Mercado Pago...';const code=pendingCode;const {data,error}=await supabase.functions.invoke('mercado-pago-create-order',{body:{product_code:code,accepted:true,policy_version:'08/10/2026',license_version:'08/10/2026',return_base_url:window.location.origin+'/loja',access_token:currentSession.access_token}});if(error||!data?.checkout_url){modalMessage.textContent='Não foi possível iniciar o checkout. Tente novamente.';continueButton.disabled=false;return;}window.location.href=data.checkout_url;});
</script>
</Base>
