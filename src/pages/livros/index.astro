---
import Base from '../../layouts/Base.astro';
const livros = [
  {href:'/livros/entre-os-tempos/',capa:'/assets/capa-entre-os-tempos.webp',titulo:'Entre os Tempos',sub:'A Urgência de Compreender o Calendário de Deus',texto:'Uma jornada por História, Filosofia, Teologia e Psicanálise para compreender o tempo, os calendários e o propósito de Deus para a experiência humana.'},
  {href:'/livros/entre-o-ja-e-o-ainda-nao/',capa:'/assets/capa-entre-o-ja-e-o-ainda-nao.webp',titulo:'Entre o Já e o Ainda Não',sub:'A Esperança Inabalável em um Mundo Acelerado',texto:'Tempo, corpo, alma e espírito se encontram numa reflexão sobre sentido, esperança e propósito em meio à velocidade do mundo contemporâneo.'},
  {href:'/livros/entre-os-sistemas-volume-1/',capa:'/assets/capa-entre-os-sistemas-volume-1.webp',titulo:'Entre os Sistemas — Volume 1',sub:'Religioso, Filosófico, Político e Econômico — Cristo, o Libertador',texto:'Uma análise histórica e crítica das estruturas que moldaram civilizações, culturas e consciências, apontando para Cristo como verdadeira liberdade.'},
  {href:'/livros/entre-os-sistemas-volume-2/',capa:'/assets/capa-entre-os-sistemas-volume-2.webp',titulo:'Entre os Sistemas — Volume 2',sub:'Fé e Doutrina — Suficiência de Cristo',texto:'Uma leitura dos sistemas teológicos e das correntes que marcaram a história da Igreja, reafirmando a centralidade e a suficiência de Cristo.'},
  {href:'/livros/entre-a-honra-e-a-gratidao/',capa:'/assets/capa-entre-a-honra-e-a-gratidao.webp',titulo:'Entre a Honra e a Gratidão',sub:'Lealdade, Fidelidade, Obediência e Amor',texto:'Um chamado para resgatar valores que formam caráter, fortalecem relacionamentos e constroem um legado que ultrapassa gerações.'}
];
---
<Base title="Livros de Romulo Schutz | Bíblia + Chimarrão" description="Conheça os livros de Romulo Schutz sobre tempo, história, fé, esperança cristã, sistemas de pensamento, honra e gratidão.">
  <section class="hero"><div class="shell"><div class="eyebrow">Livros</div><h1>Obras de Romulo Schutz.</h1><p class="lead">Uma biblioteca autoral construída no encontro entre história, fé, reflexão, filosofia e leitura do tempo presente.</p></div></section>
  <section><div class="shell"><div class="eyebrow">A trajetória do Entre</div><h2>Uma quintologia sobre tempo, esperança, sistemas e caráter.</h2><p class="lead">Cinco obras que dialogam entre si e acompanham uma mesma pergunta: como compreender o nosso tempo sem perder de vista a verdade, a esperança e o propósito?</p><div class="book-grid visual">{livros.map((livro,i)=><a class="book-card visual-card" href={livro.href}><div class="cover-wrap"><img src={livro.capa} alt={`Capa do livro ${livro.titulo}, de Romulo Schutz`} loading="lazy" /></div><div class="book-card-body"><span class="book-number">{String(i+1).padStart(2,'0')}</span><h3>{livro.titulo}</h3><p class="kicker">{livro.sub}</p><p>{livro.texto}</p><span class="text-link">Conhecer a obra →</span></div></a>)}</div></div></section>
  <section><div class="shell"><div class="eyebrow">Outras obras</div><h2>História, fé e encontro.</h2><div class="book-grid two visual">
    <a class="book-card visual-card featured" href="/livros/cristo-o-marco/"><div class="cover-wrap"><img src="/assets/capa-cristo-o-marco.webp" alt="Capa de Cristo: O Marco entre o Antes e o Depois, de Romulo Schutz" loading="lazy" /></div><div class="book-card-body"><span class="book-number">HISTÓRIA</span><h3>Cristo: O Marco entre o Antes e o Depois</h3><p class="kicker">Como a fé, a história e o calendário se encontram na linha do tempo.</p><p>Uma investigação acessível sobre a formação da era cristã e sobre como Cristo se tornou referência histórica para a contagem dos anos.</p><span class="text-link">Conhecer a obra →</span></div></a>
    <a class="book-card visual-card featured" href="/livros/chimarrao-com-deus/"><div class="cover-wrap"><img src="/assets/capa-chimarrao-com-deus.webp" alt="Capa do devocional Chimarrão com Deus — 365 Encontros com Deus, de Romulo Schutz" loading="lazy" /></div><div class="book-card-body"><span class="book-number">DEVOCIONAL</span><h3>Chimarrão com Deus — 365 Encontros com Deus</h3><p class="kicker">Mais que leitura. Um encontro real.</p><p>Um devocional diário com Palavra, reflexão, oração e aplicação prática para transformar a pausa cotidiana em um encontro com Deus.</p><span class="text-link">Conhecer o devocional →</span></div></a>
  </div></div></section>
</Base>
