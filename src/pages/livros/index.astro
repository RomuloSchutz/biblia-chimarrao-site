---
import Base from '../../layouts/Base.astro';
const livros = [
  {href:'/livros/entre-os-tempos/',titulo:'Entre os Tempos',sub:'A Urgência de Compreender o Calendário de Deus',texto:'Uma jornada por História, Filosofia, Teologia e Psicanálise para compreender o tempo, os calendários e o propósito de Deus para a experiência humana.',passo:'Compreender o tempo',capa:'/assets/capa-entre-os-tempos.jpg'},
  {href:'/livros/entre-o-ja-e-o-ainda-nao/',titulo:'Entre o Já e o Ainda Não',sub:'A Esperança Inabalável em um Mundo Acelerado',texto:'Tempo, corpo, alma e espírito se encontram numa reflexão sobre sentido, esperança e propósito em meio à velocidade do mundo contemporâneo.',passo:'Aprender a esperar',capa:'/assets/capa-entre-o-ja-e-o-ainda-nao.jpg'},
  {href:'/livros/entre-os-sistemas-volume-1/',titulo:'Entre os Sistemas — Volume 1',sub:'Religioso, Filosófico, Político e Econômico — Cristo, o Libertador',texto:'Uma análise histórica e crítica das estruturas que moldaram civilizações, culturas e consciências, apontando para Cristo como verdadeira liberdade.',passo:'Discernir as estruturas',capa:'/assets/capa-entre-os-sistemas-volume-1.png'},
  {href:'/livros/entre-os-sistemas-volume-2/',titulo:'Entre os Sistemas — Volume 2',sub:'Fé e Doutrina — Suficiência de Cristo',texto:'Uma leitura dos sistemas teológicos e das correntes que marcaram a história da Igreja, reafirmando a centralidade e a suficiência de Cristo.',passo:'Reencontrar o centro',capa:'/assets/capa-entre-os-sistemas-volume-2.png'},
  {href:'/livros/entre-a-honra-e-a-gratidao/',titulo:'Entre a Honra e a Gratidão',sub:'Lealdade, Fidelidade, Obediência e Amor',texto:'Um chamado para resgatar valores que formam caráter, fortalecem relacionamentos e constroem um legado que ultrapassa gerações.',passo:'Viver valores que permanecem',capa:'/assets/capa-entre-a-honra-e-a-gratidao.png'}
];
const outras = [
  {href:'/livros/cristo-o-marco/',titulo:'Cristo: O Marco entre o Antes e o Depois',sub:'Como a fé, a história e o calendário se encontram na linha do tempo.',texto:'Uma investigação acessível sobre a formação da era cristã e sobre como Cristo se tornou referência histórica para a contagem dos anos.',tipo:'HISTÓRIA',capa:'/assets/capa-cristo-o-marco.png'},
  {href:'/livros/chimarrao-com-deus/',titulo:'Chimarrão com Deus — 365 Encontros com Deus',sub:'Mais que leitura. Um encontro real.',texto:'Um devocional diário com Palavra, reflexão, oração e aplicação prática para transformar a pausa cotidiana em um encontro com Deus.',tipo:'DEVOCIONAL',capa:'/assets/capa-chimarrao-com-deus.jpg'}
];
const trilogia = [
  {titulo:'Entre a Cidade e o Silêncio — NASCE',texto:'O começo dos conflitos, das escolhas e das ilusões de controle em uma cidade apressada. O ipê começa a brotar; o banco ainda espera pelos encontros.',capa:'/assets/cidade-silencio-nasce.png'},
  {titulo:'Entre a Cidade e o Silêncio — CRESCE',texto:'O ipê ganha folhas e as primeiras flores; o banco se torna lugar de conversa, conselho e testemunho. A cidade continua correndo, mas alguns começam a perceber o que estavam perdendo.',capa:'/assets/cidade-silencio-cresce.png'},
  {titulo:'Entre a Cidade e o Silêncio — VIVE',texto:'O ipê floresce por inteiro. As flores caem, mas continuam embelezando o caminho. A vida amadurece em presença, serviço, esperança e legado.',capa:'/assets/cidade-silencio-vive.png'}
];
---
<Base title="Livros de Romulo Schutz | Bíblia + Chimarrão" description="Conheça os livros de Romulo Schutz sobre tempo, história, fé, esperança cristã, sistemas de pensamento, honra, gratidão e a trilogia Entre a Cidade e o Silêncio.">
  <section class="hero"><div class="shell split"><div><div class="eyebrow">Livros</div><h1>Obras de Romulo Schutz.</h1><p class="lead">Uma biblioteca autoral construída no encontro entre história, fé, reflexão, filosofia e leitura do tempo presente.</p></div><div class="card"><div class="eyebrow">Loja digital</div><h3>Conheça primeiro. Compre quando fizer sentido.</h3><p>As páginas editoriais apresentam cada obra com calma. A compra individual dos e-books será feita pela Loja, separadamente do acesso anual ao devocional.</p><a class="text-link" href="/loja/">Ir para a Loja →</a></div></div></section>

  <section><div class="shell"><div class="eyebrow">A trajetória do Entre</div><h2>Uma quintologia sobre tempo, esperança, sistemas e caráter.</h2><p class="lead">Cinco obras que dialogam entre si e acompanham uma mesma pergunta: como compreender o nosso tempo sem perder de vista a verdade, a esperança e o propósito?</p><div class="cover-gallery">{livros.map((livro,i)=><a class="cover-only-card" href={livro.href} aria-label={`Conhecer ${livro.titulo}`}><img src={livro.capa} alt={`Capa de ${livro.titulo}`} loading="lazy"/></a>)}</div></div></section>

  <section class="dark-section"><div class="shell split"><div><div class="eyebrow">Uma única caminhada</div><h2>Os títulos mudam. A pergunta continua.</h2></div><div><p class="lead">Da compreensão do tempo ao discernimento das estruturas; da espera ao reencontro com o centro; da doutrina aos valores que sustentam relações reais. A quintologia foi concebida como uma trajetória, não como uma coleção de temas isolados.</p><p>Tempo, esperança, discernimento, suficiência e caráter formam etapas de uma mesma caminhada. Cada livro pode ser lido de forma independente, mas juntos revelam uma trajetória de compreensão do mundo, da fé e da própria vida.</p></div></div></section>

  <section><div class="shell"><div class="eyebrow">Outras obras</div><h2>História, fé e encontro.</h2><div class="cover-gallery cover-gallery-two">{outras.map(livro=><a class="cover-only-card" href={livro.href} aria-label={`Conhecer ${livro.titulo}`}><img src={livro.capa} alt={`Capa de ${livro.titulo}`} loading="lazy"/></a>)}</div><div class="actions"><a class="btn primary" href="/loja/">Ver Loja digital</a></div></div></section>

  <section class="development-section"><div class="shell"><div class="eyebrow">Em desenvolvimento</div><h2>Entre a Cidade e o Silêncio</h2><p class="lead">Uma trilogia cinematográfica sobre escolhas, recomeços, encontros e a esperança que transforma. As capas apresentadas nesta fase são provisórias e serão substituídas pela versão editorial definitiva quando cada volume estiver concluído.</p><div class="cover-gallery">{trilogia.map((livro,i)=><article class="cover-only-card development-cover-card"><img src={livro.capa} alt={`Capa provisória de ${livro.titulo}`} loading="lazy"/><span class="status-badge cover-status">CAPA PROVISÓRIA · EM DESENVOLVIMENTO</span></article>)}</div><p class="note development-note">Elementos visuais permanentes da trilogia: o ipê, o banco de praça e a torre com relógio. O tempo continua passando; o sentido da caminhada se transforma.</p></div></section>
</Base>
