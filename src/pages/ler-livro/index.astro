---
import Base from '../../layouts/Base.astro';
---
<Base title="Leitor digital | Bíblia + Chimarrão" description="Leia seus livros digitais adquiridos no Bíblia + Chimarrão.">
  <section class="reader-shell">
    <div class="reader-toolbar">
      <div>
        <div class="eyebrow">Biblioteca digital</div>
        <strong id="reader-book-title">Abrindo sua leitura…</strong>
      </div>
      <div class="reader-actions">
        <button id="reader-prev" class="btn secondary" type="button" disabled>← Anterior</button>
        <button id="reader-next" class="btn secondary" type="button" disabled>Próxima →</button>
        <a class="btn secondary" href="/minha-conta/#book-library">Minha biblioteca</a>
      </div>
    </div>
    <div class="reader-stage">
      <div id="reader-status" class="reader-status">Validando seu acesso e preparando o livro…</div>
      <div id="epub-viewer" hidden></div>
    </div>
  </section>
  <!-- EPUB.js usa JSZip para abrir EPUBs empacotados. A ordem é obrigatória. -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/epubjs@0.3.93/dist/epub.min.js"></script>
  <script>
    import { supabase } from '../../lib/supabase-browser.js';
    const params=new URLSearchParams(window.location.search);
    const editionId=params.get('edition');
    const status=document.querySelector('#reader-status');
    const viewer=document.querySelector('#epub-viewer');
    const titleEl=document.querySelector('#reader-book-title');
    const prev=document.querySelector('#reader-prev');
    const next=document.querySelector('#reader-next');
    const functionUrl='https://srabzgokulsiujusbqxl.supabase.co/functions/v1/book-epub-access';
    const publishableKey='sb_publishable_TjLHUAq038yLQ2hqqaVZjg__GM4w2Q4';

    const fail=(message)=>{status.textContent=message;viewer.hidden=true;status.hidden=false;};
    if(!editionId){fail('Livro não informado. Volte para sua biblioteca e escolha uma obra.');}
    else {
      const {data:{session}}=await supabase.auth.getSession();
      if(!session?.user){window.location.href='/entrar/?next='+encodeURIComponent(window.location.pathname+window.location.search);}
      else {
        const library=await supabase.rpc('my_book_library');
        const item=(library.data||[]).find(x=>x.edition_id===editionId);
        if(item?.title) titleEl.textContent=item.title;

        let accessData=null;
        try{
          const response=await fetch(functionUrl,{
            method:'POST',
            headers:{'Content-Type':'application/json','apikey':publishableKey},
            body:JSON.stringify({edition_id:editionId,access_token:session.access_token})
          });
          const contentType=response.headers.get('content-type')||'';
          const data=contentType.includes('application/json')?await response.json():null;
          if(!response.ok) throw new Error(data?.error||`Não foi possível liberar este livro (${response.status}).`);
          if(!data?.signed_url) throw new Error(data?.error||'O servidor não liberou o arquivo deste livro.');
          accessData=data;
        }catch(err){
          console.error('book-epub-access',err);
          fail(err instanceof Error?err.message:'Não foi possível comunicar com o servidor de leitura. Atualize a página e tente novamente.');
        }

        if(accessData?.signed_url){
          if(typeof window.JSZip!=='function'){
            fail('O componente de abertura do EPUB não carregou corretamente. Atualize a página e tente novamente.');
          } else if(typeof window.ePub!=='function'){
            fail('O leitor digital não carregou corretamente. Atualize a página e tente novamente.');
          } else {
            try{
              status.textContent='Carregando o livro…';
              const epubResponse=await fetch(accessData.signed_url,{cache:'no-store'});
              if(!epubResponse.ok) throw new Error(`Falha ao carregar o arquivo (${epubResponse.status}).`);
              const epubBlob=await epubResponse.blob();
              if(!epubBlob.size) throw new Error('O arquivo do livro está vazio.');
              const epubBuffer=await epubBlob.arrayBuffer();

              const book=window.ePub(epubBuffer);
              const rendition=book.renderTo('epub-viewer',{width:'100%',height:'100%',spread:'auto',flow:'paginated'});
              await rendition.display();
              status.hidden=true;
              viewer.hidden=false;
              prev.disabled=false;next.disabled=false;
              prev.addEventListener('click',()=>rendition.prev());
              next.addEventListener('click',()=>rendition.next());
              document.addEventListener('keydown',(e)=>{if(e.key==='ArrowLeft')rendition.prev();if(e.key==='ArrowRight')rendition.next();});
            }catch(err){
              console.error('epub-render',err);
              fail(err instanceof Error?`O arquivo foi liberado, mas o leitor não conseguiu abrir a obra: ${err.message}`:'O arquivo foi liberado, mas o leitor não conseguiu renderizar esta obra.');
            }
          }
        }
      }
    }
  </script>
</Base>
