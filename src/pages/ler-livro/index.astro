---
import Base from '../../layouts/Base.astro';
---
<Base title="Leitor digital | Bíblia + Chimarrão" description="Leia seus livros digitais adquiridos no Bíblia + Chimarrão.">
  <section class="reader-shell">
    <div class="reader-toolbar">
      <div><div class="eyebrow">Biblioteca digital</div><strong id="reader-book-title">Abrindo sua leitura…</strong></div>
      <div class="reader-actions">
        <div class="reader-theme" role="group" aria-label="Cor da página">
          <button type="button" class="reader-theme-btn" data-reader-theme="white" aria-pressed="true">Branco</button>
          <button type="button" class="reader-theme-btn" data-reader-theme="sepia" aria-pressed="false">Sépia</button>
        </div>
        <a class="btn secondary" href="/loja/">Voltar à Loja</a><a class="btn secondary" href="/minha-conta/#book-library">Minha biblioteca</a>
      </div>
    </div>
    <div class="reader-wrap">
      <button id="reader-prev" class="reader-float reader-float-prev" type="button" disabled aria-label="Página anterior" title="Página anterior">‹</button>
      <div class="reader-stage" data-reader-theme="white">
        <div id="reader-status" class="reader-status">Validando seu acesso e preparando o livro…</div>
        <div id="epub-viewer" hidden></div>
      </div>
      <button id="reader-next" class="reader-float reader-float-next" type="button" disabled aria-label="Próxima página" title="Próxima página">›</button>
    </div>
    <div class="reader-hint">Use as setas laterais ou as teclas ← → para virar a página.</div>
  </section>
  <style>
    .reader-shell{width:min(calc(100% - 32px),1080px);margin:0 auto;padding:24px 0 34px;border-top:0}
    .reader-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:15px 20px;border-radius:20px;background:rgba(18,59,49,.42);margin:0 70px 14px}
    .reader-toolbar strong{font-family:Georgia,"Times New Roman",serif;font-size:1.25rem;color:#f7dfaa}
    .reader-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;align-items:center}
    .reader-theme{display:flex;align-items:center;padding:3px;border:1px solid rgba(230,196,135,.65);border-radius:999px;background:rgba(7,42,35,.45)}
    .reader-theme-btn{appearance:none;border:0;border-radius:999px;background:transparent;color:#f7dfaa;padding:8px 12px;font:600 .8rem/1.1 system-ui,sans-serif;cursor:pointer;transition:.18s ease}
    .reader-theme-btn[aria-pressed="true"]{background:#e7bd75;color:#173e34;box-shadow:0 2px 8px rgba(0,0,0,.18)}
    .reader-theme-btn:focus-visible{outline:2px solid #f8e5bb;outline-offset:2px}
    .reader-wrap{position:relative;padding:0 70px}
    .reader-stage{position:relative;height:calc(100vh - 245px);min-height:480px;max-height:720px;border:1px solid rgba(230,196,135,.28);border-radius:24px;background:#fff;overflow:hidden;box-shadow:0 18px 48px rgba(0,0,0,.12);transition:background .2s ease}
    .reader-stage[data-reader-theme="sepia"]{background:#efe3c7}
    .reader-status{padding:30px;color:#6f756f}
    #epub-viewer{width:100%;height:100%;background:#fff;color:#1f2a24;transition:background .2s ease}
    .reader-stage[data-reader-theme="sepia"] #epub-viewer{background:#efe3c7}
    #epub-viewer iframe{background:transparent!important}
    .reader-float{position:absolute;z-index:20;top:50%;transform:translateY(-50%);width:50px;height:74px;border-radius:999px;border:1px solid rgba(230,196,135,.78);background:rgba(18,59,49,.96);color:#f8e5bb;font:400 2.6rem/1 Georgia,serif;display:grid;place-items:center;cursor:pointer;box-shadow:0 10px 28px rgba(0,0,0,.24);transition:.18s ease}
    .reader-float:hover:not(:disabled),.reader-float:focus-visible:not(:disabled){background:#a7793d;color:#fff;transform:translateY(-50%) scale(1.05)}
    .reader-float:disabled{opacity:.25;cursor:default}.reader-float-prev{left:8px}.reader-float-next{right:8px}
    .reader-hint{text-align:center;color:rgba(255,248,236,.7);font-size:.82rem;padding-top:9px}
    @media(min-width:821px){
      .reader-shell.reader-shell-legacy{width:min(calc(100% - 24px),1180px)}
      .reader-shell.reader-shell-legacy .reader-toolbar{margin-left:78px;margin-right:78px}
      .reader-shell.reader-shell-legacy .reader-stage{height:calc(100vh - 175px);min-height:690px;max-height:900px}
    }
    @media(max-width:820px){.reader-shell{width:min(calc(100% - 12px),1080px);padding:12px 0 20px}.reader-toolbar{padding:12px 14px;margin:0 0 9px}.reader-toolbar strong{font-size:1.05rem}.reader-actions{justify-content:flex-start}.reader-actions .btn{min-height:40px;padding:8px 13px;font-size:.85rem}.reader-theme-btn{padding:8px 10px}.reader-wrap{padding:0 46px}.reader-stage{height:calc(100dvh - 225px);min-height:430px;border-radius:18px}.reader-float{width:38px;height:58px;font-size:2.1rem}.reader-float-prev{left:2px}.reader-float-next{right:2px}.reader-hint{font-size:.72rem}}
    @media(max-width:520px){.reader-wrap{padding:0 38px}.reader-float{width:34px;height:54px}.reader-toolbar{display:block}.reader-actions{margin-top:10px;justify-content:flex-start}.reader-actions .btn{padding:7px 10px;font-size:.78rem}}
  </style>
  <script is:inline src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/epubjs@0.3.93/dist/epub.min.js"></script>
  <script>
    import { supabase } from '../../lib/supabase-browser.js';

    const params = new URLSearchParams(window.location.search);
    const editionId = params.get('edition');
    const status = document.querySelector('#reader-status');
    const viewer = document.querySelector('#epub-viewer');
    const titleEl = document.querySelector('#reader-book-title');
    const prev = document.querySelector('#reader-prev');
    const next = document.querySelector('#reader-next');
    const readerShell = document.querySelector('.reader-shell');
    const readerStage = document.querySelector('.reader-stage');
    const themeButtons = Array.from(document.querySelectorAll('[data-reader-theme]')).filter((el) => el.classList.contains('reader-theme-btn'));
    const functionUrl = 'https://srabzgokulsiujusbqxl.supabase.co/functions/v1/book-epub-access';
    const publishableKey = 'sb_publishable_TjLHUAq038yLQ2hqqaVZjg__GM4w2Q4';
    const themeStorageKey = 'biblia-chimarrao-reader-theme';

    const fail = (message) => { status.textContent = message; viewer.hidden = true; status.hidden = false; };

    async function openReader() {
      if (!editionId) { fail('Livro não informado. Volte para sua biblioteca e escolha uma obra.'); return; }
      const { data: { session } } = await supabase.auth.getSession();
      if (!session?.user) { window.location.href = '/entrar/?next=' + encodeURIComponent(window.location.pathname + window.location.search); return; }

      const library = await supabase.rpc('my_book_library');
      const item = (library.data || []).find((x) => x.edition_id === editionId);
      if (item?.title) titleEl.textContent = item.title;
      const legacyFit = /Cristo:\s*O Marco|Entre os Sistemas|Entre a Honra e a Gratidão/i.test(item?.title || '');
      readerShell?.classList.toggle('reader-shell-legacy',legacyFit);

      let accessData = null;
      try {
        status.textContent = 'Liberando seu acesso ao livro…';
        const response = await fetch(functionUrl,{method:'POST',headers:{'Content-Type':'application/json','apikey':publishableKey},body:JSON.stringify({edition_id:editionId,access_token:session.access_token})});
        const contentType = response.headers.get('content-type') || '';
        const data = contentType.includes('application/json') ? await response.json() : null;
        if (!response.ok) throw new Error(data?.error || `Não foi possível liberar este livro (${response.status}).`);
        if (!data?.signed_url) throw new Error(data?.error || 'O servidor não liberou o arquivo deste livro.');
        accessData = data;
      } catch (err) { console.error('book-epub-access',err); fail(err instanceof Error ? err.message : 'Não foi possível comunicar com o servidor de leitura. Atualize a página e tente novamente.'); return; }

      if (typeof window.JSZip !== 'function') { fail('O componente de abertura do EPUB não carregou corretamente. Atualize a página e tente novamente.'); return; }
      if (typeof window.ePub !== 'function') { fail('O leitor digital não carregou corretamente. Atualize a página e tente novamente.'); return; }

      try {
        status.textContent = 'Baixando o EPUB autorizado…';
        const epubResponse = await fetch(accessData.signed_url,{cache:'no-store'});
        if (!epubResponse.ok) throw new Error(`Falha ao carregar o arquivo (${epubResponse.status}).`);
        const epubBuffer = await epubResponse.arrayBuffer();
        if (!epubBuffer.byteLength) throw new Error('O arquivo do livro está vazio.');

        status.textContent = 'Abrindo a estrutura do livro…';
        const book = window.ePub(epubBuffer);
        await book.ready;
        const firstSection = book.spine?.first?.();
        if (!firstSection) throw new Error('O EPUB não possui uma seção inicial de leitura.');

        viewer.hidden = false;
        viewer.style.display = 'block';
        const rendition = book.renderTo(viewer,{width:'100%',height:'100%',spread:'none',flow:'paginated',manager:'default'});
        const fontSize = legacyFit ? '126%' : '100%';
        const pagePadding = legacyFit ? '3.25%' : '5.5%';
        const commonTheme = {
          'font-family':'Georgia, serif',
          'font-size':fontSize,
          'line-height':'1.62',
          'padding-left':pagePadding,
          'padding-right':pagePadding
        };
        rendition.themes.register('white',{
          html:{background:'#ffffff',color:'#1f2a24'},
          body:{...commonTheme,background:'#ffffff',color:'#1f2a24'},
          img:{'max-width':'100%','max-height':'96vh',width:'auto',height:'auto','object-fit':'contain'}
        });
        rendition.themes.register('sepia',{
          html:{background:'#efe3c7',color:'#342d24'},
          body:{...commonTheme,background:'#efe3c7',color:'#342d24'},
          img:{'max-width':'100%','max-height':'96vh',width:'auto',height:'auto','object-fit':'contain'}
        });

        let currentTheme = 'white';
        try {
          const storedTheme = localStorage.getItem(themeStorageKey);
          if (storedTheme === 'sepia' || storedTheme === 'white') currentTheme = storedTheme;
        } catch {}

        const paintPageTheme = () => {
          try {
            rendition.getContents().forEach((contents) => {
              const doc = contents.document;
              const root = doc.documentElement;
              const body = doc.body;
              if (!root || !body) return;
              const bg = currentTheme === 'sepia' ? '#efe3c7' : '#ffffff';
              const fg = currentTheme === 'sepia' ? '#342d24' : '#1f2a24';

              let style = doc.getElementById('bc-reader-page-theme');
              if (!style) {
                style = doc.createElement('style');
                style.id = 'bc-reader-page-theme';
                (doc.head || root).appendChild(style);
              }
              style.textContent = `html,body{background:${bg}!important;color:${fg}!important} [data-bc-page-bg="1"]{background-color:${bg}!important}`;
              root.style.backgroundColor = bg;
              body.style.backgroundColor = bg;
              body.style.color = fg;

              const vw = Math.max(contents.window.innerWidth,1);
              const vh = Math.max(contents.window.innerHeight,1);
              Array.from(body.querySelectorAll('*')).forEach((el) => {
                if (!(el instanceof HTMLElement)) return;
                const tag = el.tagName.toLowerCase();
                if (['img','svg','canvas','video','script','style'].includes(tag)) return;
                const rect = el.getBoundingClientRect();
                if (rect.width < vw*.45 || rect.height < vh*.35) return;
                const computed = contents.window.getComputedStyle(el).backgroundColor.replace(/\s+/g,'').toLowerCase();
                const isWhite = computed === 'rgb(255,255,255)' || computed === 'rgba(255,255,255,1)' || computed === '#fff' || computed === '#ffffff';
                const isSepia = computed === 'rgb(239,227,199)' || computed === 'rgba(239,227,199,1)';
                if (isWhite || isSepia || el.hasAttribute('data-bc-page-bg')) el.setAttribute('data-bc-page-bg','1');
              });
            });
          } catch (e) { console.warn('epub-page-theme',e); }
        };

        const applyTheme = (theme) => {
          currentTheme = theme === 'sepia' ? 'sepia' : 'white';
          rendition.themes.select(currentTheme);
          readerStage?.setAttribute('data-reader-theme',currentTheme);
          themeButtons.forEach((button) => button.setAttribute('aria-pressed',String(button.getAttribute('data-reader-theme') === currentTheme)));
          try { localStorage.setItem(themeStorageKey,currentTheme); } catch {}
          setTimeout(paintPageTheme,20);
          setTimeout(paintPageTheme,120);
        };
        themeButtons.forEach((button) => button.addEventListener('click',() => applyTheme(button.getAttribute('data-reader-theme') || 'white')));
        applyTheme(currentTheme);

        const fitLegacyPage = () => {
          if (!legacyFit) return;
          try {
            rendition.getContents().forEach((contents) => {
              const doc = contents.document;
              const root = doc.documentElement;
              const body = doc.body;
              if (!root || !body) return;

              body.style.transform = 'none';
              body.style.transformOrigin = '0 0';
              root.style.overflow = 'hidden';

              requestAnimationFrame(() => {
                const frameW = Math.max(contents.window.innerWidth,1);
                const frameH = Math.max(contents.window.innerHeight,1);
                const elements = Array.from(body.querySelectorAll('*')).filter((el) => {
                  const tag = el.tagName?.toLowerCase();
                  if (['script','style','meta','link','head'].includes(tag)) return false;
                  const r = el.getBoundingClientRect();
                  if (r.width < 2 || r.height < 2) return false;
                  const isLeaf = el.children.length === 0 || ['img','svg','canvas'].includes(tag);
                  return isLeaf;
                });
                if (!elements.length) return;

                let left=Infinity,top=Infinity,right=-Infinity,bottom=-Infinity;
                elements.forEach((el) => {
                  const r=el.getBoundingClientRect();
                  left=Math.min(left,r.left);top=Math.min(top,r.top);right=Math.max(right,r.right);bottom=Math.max(bottom,r.bottom);
                });
                const contentW=right-left;
                const contentH=bottom-top;
                if (!Number.isFinite(contentW) || !Number.isFinite(contentH) || contentW < 10 || contentH < 10) return;

                const looksLikeSinglePage = contentW <= frameW*1.5 && contentH <= frameH*1.5;
                if (!looksLikeSinglePage) {
                  body.style.transform='none';
                  body.style.overflow='visible';
                  return;
                }

                const targetW=frameW*.78;
                const targetH=frameH*.97;
                const naturalScale=Math.min(targetW/contentW,targetH/contentH);
                const scale=Math.min(Math.max(naturalScale,1.32),1.95);
                if (!Number.isFinite(scale) || scale <= 0) return;
                const tx=(frameW-contentW*scale)/2-left*scale;
                const ty=Math.max(12,(frameH-contentH*scale)/2-top*scale);
                body.style.transformOrigin='0 0';
                body.style.transform=`translate(${tx}px, ${ty}px) scale(${scale})`;
                body.style.overflow='visible';
              });
            });
          } catch (e) { console.warn('epub-legacy-fit',e); }
        };

        rendition.on('rendered',() => { applyTheme(currentTheme); setTimeout(fitLegacyPage,60); setTimeout(paintPageTheme,140); });
        await rendition.display(firstSection.href);
        setTimeout(fitLegacyPage,100);
        setTimeout(paintPageTheme,150);
        status.hidden = true;
        prev.disabled = false;
        next.disabled = false;
        const goPrev = () => rendition.prev();
        const goNext = () => rendition.next();
        prev.addEventListener('click',goPrev); next.addEventListener('click',goNext);
        document.addEventListener('keydown',(e)=>{if(e.key==='ArrowLeft'){e.preventDefault();goPrev();}if(e.key==='ArrowRight'){e.preventDefault();goNext();}});
      } catch (err) { console.error('epub-render',err); fail(err instanceof Error ? `O arquivo foi liberado, mas o leitor não conseguiu abrir a obra: ${err.message}` : 'O arquivo foi liberado, mas o leitor não conseguiu renderizar esta obra.'); }
    }
    openReader();
  </script>
</Base>
