---
import Base from '../../layouts/Base.astro';
const months=[
 [1,'Janeiro','Recomeços'],[2,'Fevereiro','Intimidade'],[3,'Março','Fé'],[4,'Abril','Cruz e Ressurreição'],[5,'Maio','Relacionamentos'],[6,'Junho','Propósito'],[7,'Julho','Tempos'],[8,'Agosto','Tempestades'],[9,'Setembro','Transformação'],[10,'Outubro','Gratidão'],[11,'Novembro','Generosidade'],[12,'Dezembro','Esperança e Celebração']
];
---
<Base title="Devocional | Bíblia + Chimarrão" description="Leia Chimarrão com Deus — 365 Encontros com Deus pelo site usando a mesma conta e o mesmo acesso da Edição 2027 do aplicativo.">
<section class="hero devotional-web-hero"><div class="shell"><div class="eyebrow">Chimarrão com Deus</div><h1>365 Encontros com Deus</h1><p class="lead">Sua caminhada também pode ser lida aqui. Entre com a mesma conta do aplicativo e continue pelos doze meses da Edição 2027.</p></div></section>
<section><div class="shell">
 <div id="dev-loading" class="account-panel"><p>Verificando seu acesso...</p></div>
 <div id="dev-login" class="account-panel" hidden><h2>Entre para ler.</h2><p>Use o mesmo e-mail e senha do aplicativo Bíblia + Chimarrão.</p><div class="actions"><a class="btn primary" href="/entrar/">Entrar ou criar conta</a></div></div>
 <div id="dev-locked" class="account-panel" hidden><div class="eyebrow">Edição 2027</div><h2>Este conteúdo ainda não está liberado para sua conta.</h2><p>Você pode conhecer o projeto e adquirir a edição anual. A compra ficará disponível tanto no site quanto no aplicativo.</p><div class="actions"><a class="btn primary" href="/loja/">Conhecer a Edição 2027</a><a class="btn secondary" href="/minha-conta/">Minha Conta</a></div></div>
 <div id="dev-content" hidden><div class="dev-reader-heading"><div><div class="eyebrow">Edição 2027</div><h2>Escolha um mês</h2><p>Uma caminhada de 365 encontros, um dia de cada vez.</p></div><a class="btn secondary" href="/minha-conta/">Minha Conta</a></div>
  <div id="month-grid" class="month-web-grid">{months.map(([number,name,theme])=><button class="month-web-card" type="button" data-month={number}><img src={`/devocional/mes_${String(number).padStart(2,'0')}.jpg`} alt={`Card de ${name}`} loading="lazy"/><span><strong>{name}</strong><small>{theme}</small></span></button>)}</div>
  <div id="day-view" class="reader-view" hidden><button id="back-months" class="back-link" type="button">← Voltar aos meses</button><div class="eyebrow" id="selected-month-eyebrow">Mês</div><h2 id="selected-month-title">Mês</h2><div id="days-list" class="days-web-grid"></div></div>
  <article id="encounter-view" class="encounter-web" hidden><button id="back-days" class="back-link" type="button">← Voltar aos dias</button><div class="encounter-date" id="encounter-date"></div><h2 id="encounter-title"></h2><section class="encounter-block"><span>Bom Dia, Deus</span><p id="encounter-bom-dia"></p></section><section class="encounter-block scripture"><span>A Palavra</span><blockquote id="encounter-verse"></blockquote><strong id="encounter-reference"></strong></section><section class="encounter-block"><span>Mate da Reflexão</span><p id="encounter-reflection"></p></section><section class="encounter-block"><span>Para Pensar</span><p id="encounter-think"></p></section><section class="encounter-block"><span>Conversa com Deus</span><p id="encounter-prayer"></p></section><section class="encounter-block"><span>Um Passo para Hoje</span><p id="encounter-step"></p></section></article>
 </div>
</div></section>
<script>
 import { supabase } from '../../lib/supabase-browser.js';
 const editionId='e9ced096-9c32-4f64-b3af-d25fc6781fb6';
 const monthNames=['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
 const loading=document.querySelector('#dev-loading'),login=document.querySelector('#dev-login'),locked=document.querySelector('#dev-locked'),content=document.querySelector('#dev-content'),monthGrid=document.querySelector('#month-grid'),dayView=document.querySelector('#day-view'),encounterView=document.querySelector('#encounter-view'),daysList=document.querySelector('#days-list');
 const {data:{session}}=await supabase.auth.getSession();
 if(!session?.user){loading.hidden=true;login.hidden=false;} else {
   const {data,error}=await supabase.rpc('get_my_annual_access',{target_year:2027});loading.hidden=true;
   if(error||!data?.[0]?.allowed){locked.hidden=false;} else content.hidden=false;
 }
 document.querySelectorAll('.month-web-card').forEach(button=>button.addEventListener('click',()=>openMonth(Number(button.dataset.month))));
 document.querySelector('#back-months')?.addEventListener('click',()=>{dayView.hidden=true;encounterView.hidden=true;monthGrid.hidden=false;window.scrollTo({top:0,behavior:'smooth'});});
 document.querySelector('#back-days')?.addEventListener('click',()=>{encounterView.hidden=true;dayView.hidden=false;window.scrollTo({top:dayView.offsetTop-90,behavior:'smooth'});});
 async function openMonth(month){monthGrid.hidden=true;encounterView.hidden=true;dayView.hidden=false;document.querySelector('#selected-month-eyebrow').textContent=`MÊS ${String(month).padStart(2,'0')}`;document.querySelector('#selected-month-title').textContent=monthNames[month];daysList.innerHTML='<p>Carregando encontros...</p>';const {data,error}=await supabase.from('encontros').select('day_number,day_of_month,title,theme').eq('edition_id',editionId).eq('month_number',month).eq('is_published',true).order('day_number');if(error){daysList.innerHTML='<p>Não foi possível carregar este mês.</p>';return;}daysList.innerHTML=(data||[]).map(d=>`<button class="day-web-card" data-day="${d.day_number}"><span>${String(d.day_of_month).padStart(2,'0')}</span><div><small>Dia ${d.day_number}</small><strong>${escapeHtml(d.title)}</strong></div><b>›</b></button>`).join('');daysList.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>openEncounter(Number(b.dataset.day))));window.scrollTo({top:dayView.offsetTop-90,behavior:'smooth'});}
 async function openEncounter(day){const access=await supabase.rpc('get_my_annual_access',{target_year:2027});if(!access.data?.[0]?.allowed){content.hidden=true;locked.hidden=false;return;}const {data,error}=await supabase.from('encontros').select('*').eq('edition_id',editionId).eq('day_number',day).eq('is_published',true).maybeSingle();if(error||!data)return;dayView.hidden=true;encounterView.hidden=false;document.querySelector('#encounter-date').textContent=`DIA ${data.day_number} · ${data.day_of_month} DE ${String(data.month_name||'').toUpperCase()}`;document.querySelector('#encounter-title').textContent=data.title||'';document.querySelector('#encounter-bom-dia').textContent=data.bom_dia_deus||'';document.querySelector('#encounter-verse').textContent=data.verse_text||'';document.querySelector('#encounter-reference').textContent=data.verse_reference||'';document.querySelector('#encounter-reflection').textContent=data.mate_da_vida||data.reflection||'';document.querySelector('#encounter-think').textContent=data.para_pensar||'';document.querySelector('#encounter-prayer').textContent=data.conversa_com_deus||data.prayer||'';document.querySelector('#encounter-step').textContent=data.um_passo_para_hoje||data.application||'';window.scrollTo({top:encounterView.offsetTop-90,behavior:'smooth'});}
 function escapeHtml(v=''){return String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));}
</script>
</Base>
