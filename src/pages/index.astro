---
import Base from '../layouts/Base.astro';
import { carimboOficial } from '../data/carimbo.js';
const appUrl = 'https://biblia-chimarrao-pwa.rommar2179.workers.dev/';
---
<Base title="Bíblia + Chimarrão | Palavra, pausa, reflexão e encontro" description="Conheça o Bíblia + Chimarrão — um espaço de pausa, reflexão e encontro com Deus. Projeto de Romulo Schutz com devocional, livros e experiência digital cristã.">
  <section class="hero"><div class="shell hero-grid">
    <div><div class="eyebrow">Projeto oficial</div><h1>Bíblia +<br/>Chimarrão</h1><p class="lead">Conheça o Bíblia + Chimarrão — um espaço de pausa, reflexão e encontro com Deus.</p><div class="actions"><a class="btn primary" href={appUrl} target="_blank" rel="noopener noreferrer">Conheça o aplicativo</a><a class="btn secondary" href="/livros/">Conheça os livros</a><a class="btn secondary" href="/loja/">Loja digital</a></div></div>
    <aside class="hero-card"><img src={carimboOficial} alt="Carimbo oficial Bíblia + Chimarrão" style="width:min(100%,430px);display:block;margin:0 auto 1.5rem;filter:drop-shadow(0 20px 34px rgba(0,0,0,.24));"/><div><div class="eyebrow" style="color:#d8bd91">365 encontros</div><h3>Chimarrão com Deus</h3><p>Devocional cristão anual de Romulo Schutz, integrado ao universo Bíblia + Chimarrão.</p></div></aside>
  </div></section>

  <section class="journey-intro"><div class="shell split"><div><div class="eyebrow">Uma caminhada</div><h2>A vida não acontece em um único capítulo.</h2></div><div><p class="lead">Os livros, o devocional e o aplicativo fazem parte de uma mesma proposta: acompanhar pessoas em uma trajetória de compreensão, amadurecimento, fé, escolhas, serviço e propósito.</p><p>Há momentos de recomeçar, esperar, enfrentar sistemas, revisar crenças, aprender gratidão, servir, cair, levantar e continuar. O Bíblia + Chimarrão nasce para caminhar nesse território da vida real — sem pressa e sem respostas rasas.</p></div></div></section>

  <section><div class="shell"><div class="eyebrow">Essência</div><h2>Uma pausa que devolve atenção ao que importa.</h2><div class="grid-3"><article class="card"><h3>Palavra</h3><p>A Bíblia ocupa o centro. O conteúdo conduz à leitura, compreensão e aplicação da Palavra de Deus.</p></article><article class="card"><h3>Pausa e reflexão</h3><p>O chimarrão representa um momento cotidiano de pausa. Não é objeto religioso, mas expressão cultural de presença, conversa e tempo intencional.</p></article><article class="card"><h3>Encontro</h3><p>O projeto propõe constância: tempo para pensar, orar, anotar, aprender e caminhar com propósito.</p></article></div></div></section>

  <section><div class="shell split"><div><div class="eyebrow">Devocional</div><h2>Chimarrão com Deus — 365 Encontros com Deus</h2></div><div><p class="lead">Um devocional anual concebido para acompanhar o leitor diariamente, com Palavra, reflexão, oração e aplicação prática.</p><p class="note">O ISBN da edição digital será acrescentado somente após sua emissão oficial pela CBL.</p><a class="btn secondary" href="/chimarrao-com-deus/">Conhecer o devocional</a></div></div></section>

  <section class="dark-section"><div class="shell"><div class="eyebrow">A trajetória do Entre</div><h2>Cinco livros. Uma mesma caminhada.</h2><p class="lead">A quintologia percorre o tempo, a esperança, os sistemas que moldam o mundo, a fé e os valores que sustentam uma vida com propósito.</p><div class="journey-steps"><a href="/livros/entre-os-tempos/"><span>01</span><strong>Entre os Tempos</strong><small>Compreender o tempo.</small></a><a href="/livros/entre-o-ja-e-o-ainda-nao/"><span>02</span><strong>Entre o Já e o Ainda Não</strong><small>Aprender a esperar.</small></a><a href="/livros/entre-os-sistemas-volume-1/"><span>03</span><strong>Entre os Sistemas — Volume 1</strong><small>Discernir as estruturas.</small></a><a href="/livros/entre-os-sistemas-volume-2/"><span>04</span><strong>Entre os Sistemas — Volume 2</strong><small>Reencontrar o centro.</small></a><a href="/livros/entre-a-honra-e-a-gratidao/"><span>05</span><strong>Entre a Honra e a Gratidão</strong><small>Viver valores que permanecem.</small></a></div><div class="actions"><a class="btn light" href="/livros/">Explorar a biblioteca</a></div></div></section>

  <section><div class="shell split"><div><div class="eyebrow">Romulo Schutz</div><h2>Escrever é transformar estudo em caminho.</h2><p class="lead">História, fé cristã, filosofia, cultura e vida cotidiana se encontram em uma escrita que convida o leitor a pensar com profundidade sem perder a simplicidade.</p><div class="actions"><a class="btn secondary" href="/autor/">Conhecer o autor</a></div></div><div><img src="/assets/autor-romulo.webp" alt="Romulo Schutz, escritor e criador do Bíblia + Chimarrão" class="portrait-feature"/></div></div></section>

  <section><div class="shell"><div class="eyebrow">Escolha sua porta de entrada</div><h2>Aplicativo, livros ou devocional.</h2><div class="grid-3"><article class="card"><h3>Aplicativo Bíblia + Chimarrão</h3><p>Devocional, encontro diário, caminhada, favoritos, anotações, biblioteca e conteúdos em uma experiência digital integrada.</p><a class="text-link" href={appUrl} target="_blank" rel="noopener noreferrer">Acessar o aplicativo →</a></article><article class="card"><h3>Biblioteca de livros</h3><p>Conheça cada obra, sua proposta, seus temas e a trajetória que conecta os títulos.</p><a class="text-link" href="/livros/">Conhecer os livros →</a></article><article class="card"><h3>Loja digital</h3><p>Área preparada para permitir a compra individual dos e-books, sem exigir a aquisição do aplicativo.</p><a class="text-link" href="/loja/">Ver a loja →</a></article></div></div></section>
</Base>
