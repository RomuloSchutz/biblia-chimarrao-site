---
import Base from '../layouts/Base.astro';
import { carimboOficial } from '../data/carimbo.js';
const appUrl = 'https://biblia-chimarrao-pwa.rommar2179.workers.dev/';
---
<Base title="Bíblia + Chimarrão | Palavra, pausa, reflexão e encontro" description="Conheça o Bíblia + Chimarrão — um espaço de pausa, reflexão e encontro com Deus. Projeto de Romulo Schutz com devocional, livros e experiência digital cristã.">
  <section class="hero"><div class="shell hero-grid">
    <div><div class="eyebrow">Projeto oficial</div><h1>Bíblia +<br/>Chimarrão</h1><p class="lead">Conheça o Bíblia + Chimarrão — um espaço de pausa, reflexão e encontro com Deus.</p><div class="actions"><a class="btn primary" href={appUrl} target="_blank" rel="noopener noreferrer">Conheça o aplicativo</a><a class="btn secondary" href="/chimarrao-com-deus/">Chimarrão com Deus</a></div></div>
    <aside class="hero-card"><img src={carimboOficial} alt="Carimbo oficial Bíblia + Chimarrão" style="width:min(100%,430px);display:block;margin:0 auto 1.5rem;filter:drop-shadow(0 20px 34px rgba(0,0,0,.24));"/><div><div class="eyebrow" style="color:#d8bd91">365 encontros</div><h3>Chimarrão com Deus</h3><p>Devocional cristão anual de Romulo Schutz, integrado ao universo Bíblia + Chimarrão.</p></div></aside>
  </div></section>
  <section><div class="shell"><div class="eyebrow">Essência</div><h2>Uma pausa que devolve atenção ao que importa.</h2><div class="grid-3"><article class="card"><h3>Palavra</h3><p>A Bíblia ocupa o centro. O conteúdo conduz à leitura, compreensão e aplicação da Palavra de Deus.</p></article><article class="card"><h3>Pausa e reflexão</h3><p>O chimarrão representa um momento cotidiano de pausa. Não é objeto religioso, mas expressão cultural de presença, conversa e tempo intencional.</p></article><article class="card"><h3>Encontro</h3><p>O projeto propõe constância: tempo para pensar, orar, anotar, aprender e caminhar com propósito.</p></article></div></div></section>
  <section><div class="shell split"><div><div class="eyebrow">Devocional</div><h2>Chimarrão com Deus — 365 Encontros com Deus</h2></div><div><p class="lead">Um devocional anual concebido para acompanhar o leitor diariamente, com Palavra, reflexão, oração e aplicação prática.</p><p class="note">O ISBN da edição digital será acrescentado somente após sua emissão oficial pela CBL.</p><a class="btn secondary" href="/chimarrao-com-deus/">Conhecer o devocional</a></div></div></section>
  <section><div class="shell"><div class="eyebrow">Universo autoral</div><h2>Livros, história, fé e reflexão.</h2><div class="grid-3"><article class="card"><h3>Quintologia do Entre</h3><p>Uma sequência de obras que percorre tempo, esperança, sistemas de pensamento, fé, doutrina, honra e gratidão.</p><a href="/livros/">Conhecer os livros →</a></article><article class="card"><h3>Aplicativo Bíblia + Chimarrão</h3><p>Devocional, encontro diário, caminhada, favoritos, anotações, biblioteca e conteúdos em uma experiência digital integrada.</p><a href={appUrl} target="_blank" rel="noopener noreferrer">Acessar o aplicativo →</a></article><article class="card"><h3>Romulo Schutz</h3><p>Escritor e pesquisador dedicado ao encontro entre história, fé cristã, filosofia e leitura do tempo presente.</p><a href="/autor/">Sobre o autor →</a></article></div></div></section>
</Base>
