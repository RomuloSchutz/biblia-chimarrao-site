---
import Base from '../../layouts/Base.astro';
const meses = [
  { numero: 1, nome: 'Janeiro', tema: 'Recomeços', arquivo: '01_janeiro.webp' },
  { numero: 2, nome: 'Fevereiro', tema: 'Intimidade', arquivo: '02_fevereiro.webp' },
  { numero: 3, nome: 'Março', tema: 'Fé', arquivo: '03_marco.webp' },
  { numero: 4, nome: 'Abril', tema: 'Cruz e Ressurreição', arquivo: '04_abril.webp' },
  { numero: 5, nome: 'Maio', tema: 'Relacionamentos', arquivo: '05_maio.webp' },
  { numero: 6, nome: 'Junho', tema: 'Propósito', arquivo: '06_junho.webp' },
  { numero: 7, nome: 'Julho', tema: 'Tempo e Espera', arquivo: '07_julho.webp' },
  { numero: 8, nome: 'Agosto', tema: 'Tempestades', arquivo: '08_agosto.webp' },
  { numero: 9, nome: 'Setembro', tema: 'Transformação', arquivo: '09_setembro.webp' },
  { numero: 10, nome: 'Outubro', tema: 'Gratidão', arquivo: '10_outubro.webp' },
  { numero: 11, nome: 'Novembro', tema: 'Generosidade', arquivo: '11_novembro.webp' },
  { numero: 12, nome: 'Dezembro', tema: 'Esperança e Celebração', arquivo: '12_dezembro.webp' },
];
---
<Base title="Chimarrão com Deus — 365 Encontros com Deus | Romulo Schutz" description="Conheça Chimarrão com Deus — 365 Encontros com Deus, devocional cristão anual de Romulo Schutz, integrado ao projeto Bíblia + Chimarrão.">
<section class="hero compact-hero"><div class="shell devotional-hero-grid"><div><div class="eyebrow">Devocional cristão</div><h1>Chimarrão com Deus</h1><p class="lead">365 Encontros com Deus. Uma jornada anual de leitura bíblica, reflexão, oração e passos práticos para o cotidiano.</p><p>Não é uma leitura para ser vencida com pressa. É um convite para criar constância: abrir a Palavra, refletir com calma e levar uma pequena direção para dentro do dia.</p><div class="actions"><a class="btn primary" href="/devocional/">Ler o devocional</a><a class="btn secondary" href="/aplicativo/">Ver no aplicativo</a><a class="btn secondary" href="/loja/">Ver na loja</a></div></div><figure class="devotional-front-cover"><img src="/assets/capa-chimarrao-com-deus.png" alt="Capa do devocional Chimarrão com Deus — 365 Encontros com Deus"/></figure></div></section>
<section><div class="shell grid-3"><article class="card"><h3>A Palavra</h3><p>O encontro diário começa na Escritura e conduz a uma leitura intencional, buscando compreender antes de aplicar.</p></article><article class="card"><h3>Reflexão</h3><p>O texto devocional conecta a mensagem bíblica às perguntas, decisões, relacionamentos e experiências da vida real.</p></article><article class="card"><h3>Um passo para hoje</h3><p>A jornada convida a responder com prática, oração, anotações e continuidade — um dia de cada vez.</p></article></div></section>
<section class="meses-section"><div class="shell"><div class="eyebrow">A jornada do ano</div><h2>12 meses. 12 temas. Um encontro por dia.</h2><p class="lead meses-intro">Cada mês do <strong>Chimarrão com Deus</strong> possui uma identidade visual e um tema próprio. Se sua conta já tem acesso à Edição 2027, toque em qualquer mês e comece a leitura diretamente. Caso ainda não tenha acesso, o site mostrará as opções disponíveis.</p><div class="meses-grid">{meses.map(mes=><a class="mes-card" href={`/devocional/?month=${mes.numero}`} aria-label={`Abrir ${mes.nome} — ${mes.tema}`}><img src={`/${mes.arquivo}`} alt={`${mes.nome} — ${mes.tema} | Chimarrão com Deus`} loading="lazy" decoding="async" width="600" height="400"/><div class="mes-meta"><span>{mes.nome}</span><strong>{mes.tema}</strong></div><div class="mes-open">Ler este mês <b>→</b></div></a>)}</div></div></section>
</Base>
<style>
.meses-section{padding-top:1rem}.meses-intro{max-width:820px;margin-bottom:2rem}.meses-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.mes-card{display:block;margin:0;background:#fffaf1;border:1px solid rgba(52,73,58,.14);border-radius:20px;overflow:hidden;box-shadow:0 14px 32px rgba(31,49,39,.08);text-decoration:none;color:inherit;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.mes-card:hover,.mes-card:focus-visible{transform:translateY(-4px);box-shadow:0 20px 42px rgba(18,59,49,.16);border-color:rgba(197,154,85,.48);outline:none}.mes-card img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;background:#f5efe4}.mes-meta{padding:1rem 1.1rem .55rem;display:flex;align-items:baseline;justify-content:space-between;gap:.75rem}.mes-meta span{font-family:Georgia,'Times New Roman',serif;font-size:1.12rem;color:#173f31}.mes-meta strong{font-size:.86rem;letter-spacing:.04em;text-transform:uppercase;color:#9a6b25;text-align:right}.mes-open{padding:0 1.1rem 1rem;font-size:.82rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#315f4d;display:flex;justify-content:space-between;align-items:center}.mes-open b{font-size:1rem}@media(max-width:900px){.meses-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.meses-grid{grid-template-columns:1fr;gap:1rem}}
html[data-theme="dark"] .mes-card{background:#171f1b;border-color:rgba(226,190,127,.2)}html[data-theme="dark"] .mes-card img{background:#101b17}html[data-theme="dark"] .mes-meta span{color:#f4eee4}html[data-theme="dark"] .mes-open{color:#d7b373}
</style>
